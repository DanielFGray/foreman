{
  "name": "foreman",
  "private": true,
  "bin": {
    "foreman": "./src/main.ts"
  },
  "type": "module",
  "module": "index.ts",
  "scripts": {
    "start": "bun src/main.ts",
    "test": "run-s format:check lint typecheck test:unit",
    "test:unit": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src",
    "prepare": "effect-tsgo patch --typescript --oxlint"
  },
  "dependencies": {
    "@effect/cli": "^0.77.0",
    "@effect/opentelemetry": "^0.64.0",
    "@effect/platform": "^0.97.1",
    "@effect/platform-bun": "^0.91.2",
    "effect": "^3.22.1",
    "lodash": "^4.18.1",
    "npm-run-all": "^4.1.5"
  },
  "devDependencies": {
    "@effect/language-service": "^0.87.2",
    "@effect/tsgo": "0.36.4",
    "@types/bun": "^1.3.14",
    "@types/lodash": "^4.17.25",
    "oxfmt": "^0.63.0",
    "oxlint": "1.77.0",
    "oxlint-tsgolint": "7.0.2001",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
