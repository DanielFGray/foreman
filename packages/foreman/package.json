{
  "name": "foreman",
  "private": true,
  "bin": {
    "foreman": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./composite": "./src/composite.ts",
    "./pipeline": "./src/pipeline.ts",
    "./pipeline-belt": "./src/pipeline-belt.ts",
    "./pipeline-draft": "./src/pipeline-draft.ts",
    "./pipeline-edit": "./src/pipeline-edit.ts",
    "./pipeline-file": "./src/pipeline-file.ts",
    "./pipeline-fixture": "./src/pipeline-fixture.ts",
    "./pipeline-layout": "./src/pipeline-layout.ts",
    "./pipeline-view": "./src/pipeline-view.ts",
    "./published-schema": "./src/published-schema.ts",
    "./ui-contract": "./src/ui-contract.ts",
    "./ui-server": "./src/ui-server.ts",
    "./pipeline-graph": "./src/pipeline-graph.ts",
    "./pipeline-graph-view": "./src/pipeline-graph-view.ts",
    "./board-columns": "./src/board-columns.ts",
    "./view-names": "./src/view-names.ts",
    "./policy": "./src/policy.ts",
    "./policy-file": "./src/policy-file.ts"
  },
  "scripts": {
    "test": "run-s format:check lint typecheck test:unit",
    "test:unit": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --type-aware src && oxlint -c herdr/foreman/.oxlintrc.json herdr/foreman",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.2",
    "effect": "4.1.2",
    "npm-run-all": "^4.1.5",
    "tasks": "workspace:*"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
