{
  "name": "foreman",
  "private": true,
  "bin": {
    "foreman": "./src/main.ts"
  },
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./pipeline": "./src/pipeline.ts",
    "./pipeline-belt": "./src/pipeline-belt.ts",
    "./pipeline-edit": "./src/pipeline-edit.ts",
    "./pipeline-layout": "./src/pipeline-layout.ts"
  },
  "scripts": {
    "test": "run-s format:check lint typecheck test:unit",
    "test:unit": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0",
    "effect": "4.1.0",
    "npm-run-all": "^4.1.5",
    "tasks": "workspace:*"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2"
  },
  "peerDependencies": {
    "typescript": "^7.0.2"
  }
}
