{
  "name": "foreman-ui",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "run-s format:check lint typecheck test:unit",
    "test:unit": "bunx --bun vitest run",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --type-aware src test",
    "format": "oxfmt --write src test",
    "format:check": "oxfmt --check src test",
    "dev": "bun run src/dev.ts"
  },
  "dependencies": {
    "@effect/atom-react": "4.1.2",
    "@effect/platform-browser": "4.1.2",
    "@effect/platform-bun": "4.1.2",
    "dragology": "0.2.0",
    "effect": "4.1.2",
    "foreman": "workspace:*",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "scheduler": "0.27.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@effect/vitest": "4.1.2",
    "@types/bun": "^1.3.14",
    "@types/react": "^19.2.2",
    "@types/react-dom": "^19.2.2",
    "@vitest/browser": "5.1.0",
    "@vitest/browser-playwright": "5.1.0",
    "npm-run-all": "^4.1.5",
    "oxfmt": "^0.63.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "playwright": "1.64.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
