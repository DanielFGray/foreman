{
  "name": "tasks",
  "private": true,
  "type": "module",
  "bin": {
    "tasks": "./src/cli/main.ts"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "run-s format:check lint typecheck test:unit",
    "test:unit": "bun test",
    "typecheck": "bunx tsc --noEmit",
    "lint": "oxlint --type-aware src",
    "format": "oxfmt --write src",
    "format:check": "oxfmt --check src"
  },
  "dependencies": {
    "@effect/platform-bun": "4.1.0",
    "@effect/sql-sqlite-bun": "4.1.0",
    "effect": "4.1.0"
  },
  "devDependencies": {
    "@effect/tsgo": "0.63.0",
    "@types/bun": "^1.3.14",
    "oxfmt": "^0.63.0",
    "oxlint": "1.90.0",
    "oxlint-tsgolint": "7.0.2005",
    "typescript": "7.0.2",
    "npm-run-all": "^4.1.5"
  }
}
