#!/bin/bash
# A foreman worktree shares none of the main checkout's installed dependencies,
# so a dispatch into one needs them installed before the agent starts. The
# package manager's own install is already safe to run again, which is what
# makes a re-run the repair for a worktree whose deps went stale.
set -euo pipefail

bun install

# The page's browser tests run on the Chromium build this checkout's pinned
# Playwright names. The browser cache is shared by every project on the
# machine, and another project's Playwright can replace that build, so setup
# installs it. Playwright skips the download when the build is present.
# Skipping its garbage collection keeps the builds other projects use.
(cd packages/foreman-ui && PLAYWRIGHT_SKIP_BROWSER_GC=1 bunx playwright install chromium-headless-shell)
